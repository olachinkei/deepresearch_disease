# Runtime mode: mock is deterministic and never calls Gemini or Exa.
AGENT_RUNTIME_MODE=mock
AGENT_MODEL=gemini-3.6-flash
AGENT_DATABASE_PATH=./data/corpus.sqlite
AGENT_SESSION_DATABASE_PATH=./data/sessions.sqlite
AGENT_MODEL=gemini-3.6-flash
AGENT_PROMPT_VERSION=v1
AGENT_CORPUS_VERSION=public-seed-v1
AGENT_HMAC_SECRET=replace-with-at-least-32-random-characters

# External-data gates: all default to false.
AGENT_ALLOW_TARGET_TO_EXA=false
AGENT_ALLOW_PUBLIC_CONTENT_TO_GEMINI=false
AGENT_ALLOW_INTERNAL_CONTENT_TO_GEMINI=false
AGENT_ALLOW_RESEARCH_HYPOTHESIS_TO_GEMINI=false
AGENT_TRACE_CONTENT_ENABLED=false
AGENT_TRACE_RESEARCH_HYPOTHESES_ENABLED=false
AGENT_FEEDBACK_COMMENT_TO_WANDB_ENABLED=false
AGENT_INTERNAL_INGESTION_ENABLED=false

# Optional providers.
EXA_API_KEY=
GOOGLE_API_KEY=
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=

# ADK raw content is never exported.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
ADK_TELEMETRY_IGNORE_RUN_CONFIG=true

# Raw OTel -> Weave Agents. Leave unset to disable export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.name=deepresearch-disease-agent
# After approval, set:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://trace.wandb.ai/agents/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=wandb-api-key=YOUR_WANDB_API_KEY
# OTEL_RESOURCE_ATTRIBUTES=service.name=deepresearch-disease-agent,wandb.entity=YOUR_ENTITY,wandb.project=YOUR_PROJECT
WANDB_ENTITY=
WANDB_PROJECT=
WANDB_API_KEY=
