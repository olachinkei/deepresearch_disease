# Web
APP_ORIGIN=http://localhost:3000
WEB_DATABASE_URL=file:./data/web.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
AGENT_SERVICE_URL=http://127.0.0.1:8001
AGENT_REQUEST_TIMEOUT_MS=180000

# Agent runtime
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
AGENT_RUNTIME_MODE=mock
AGENT_MODEL=gemini-3.6-flash
AGENT_DATABASE_PATH=./data/corpus.sqlite
AGENT_SESSION_DATABASE_PATH=./data/sessions.sqlite
AGENT_CORPUS_VERSION=public-seed-20260730-c8457953
GOOGLE_API_KEY=
AGENT_MODEL=gemini-2.5-flash
AGENT_HMAC_SECRET=replace-with-a-distinct-at-least-32-character-secret
EXA_API_KEY=
AGENT_ALLOW_TARGET_TO_EXA=false
AGENT_ALLOW_PUBLIC_CONTENT_TO_GEMINI=false
AGENT_ALLOW_INTERNAL_CONTENT_TO_GEMINI=false
AGENT_ALLOW_RESEARCH_HYPOTHESIS_TO_GEMINI=false
AGENT_TRACE_CONTENT_ENABLED=false
AGENT_TRACE_RESEARCH_HYPOTHESES_ENABLED=false
AGENT_FEEDBACK_COMMENT_TO_WANDB_ENABLED=false
AGENT_INTERNAL_INGESTION_ENABLED=false
INTERNAL_PDF_DIR=
INTERNAL_MANIFEST_PATH=

# Raw OpenTelemetry -> Weave Agents. Keep message/tool content capture disabled.
OTEL_SERVICE_NAME=deepresearch-disease-agent
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.name=deepresearch-disease-agent,service.version=dev
# To enable the explicit public/synthetic W&B smoke, set:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://trace.wandb.ai/agents/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=wandb-api-key=YOUR_WANDB_API_KEY
# OTEL_RESOURCE_ATTRIBUTES=service.name=deepresearch-disease-agent,wandb.entity=YOUR_ENTITY,wandb.project=YOUR_PROJECT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
ADK_TELEMETRY_IGNORE_RUN_CONFIG=true

# Weave SDK is used only by offline evaluation, feedback sync, and analysis scripts.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# Optional metadata enrichment. Unpaywall requires a real contact address.
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=
